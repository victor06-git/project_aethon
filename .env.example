# Copy to .env (git-ignored). Everything is optional: without keys the app answers by rules on demo data.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# --- Gemini: the trainer agent (function calling) and the question classifier ---
# auto = Gemini when GEMINI_API_KEY is set, otherwise rules only. none = model off.
REVI_LLM_PROVIDER=auto
GEMINI_API_KEY=
REVI_LLM_MODEL=gemini-3.8-flash
REVI_LLM_TIMEOUT_MS=8000
# The trainer makes several Gemini calls per answer (tools, then text):
REVI_AGENT_TIMEOUT_MS=20000
# OpenAI-compatible endpoint for the classifier instead (e.g. self-hosted Gemma). The trainer agent needs Gemini.
# REVI_LLM_PROVIDER=openai
# REVI_LLM_URL=http://localhost:8000/v1/chat/completions
# REVI_LLM_KEY=

# --- Exa web search: live prices and benchmarks for the trainer (https://exa.ai) ---
# Without a key the trainer says research is off and keeps its assumptions.
EXA_API_KEY=
REVI_EXA_TIMEOUT_MS=8000
# REVI_EXA_BASE_URL=https://api.exa.ai   (change only to point at a stand-in for offline demos)

# --- Data ---
# auto = S-Pankki CSV if present, otherwise demo fixtures. Values: auto | csv | fixture
REVI_DATA_SOURCE=auto
REVI_DATASET=data/tx_junction_transactions.csv
REVI_CUSTOMER_ID=CUST00001
# Optional in an access-controlled Vercel preview: gzip+base64 of one synthetic customer.
# Generate with tools/pack-demo-dataset.py. Keep the output out of Git.
# REVI_DATASET_GZIP_BASE64=

# --- Server ---
PORT=3000
# Only if the frontend is served from another origin than the API (not needed on Vercel or with npm start):
# REVI_CORS_ORIGIN=https://your-frontend.example.com
