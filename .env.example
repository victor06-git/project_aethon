# Copy to .env (git-ignored). Everything is optional.

# --- Model (owned by the model teammate; see backend/src/infrastructure/llm/README.md) ---
# auto = Gemini when GEMINI_API_KEY is set, otherwise rules only. none = model off.
KAIKU_LLM_PROVIDER=auto
GEMINI_API_KEY=
KAIKU_LLM_MODEL=gemini-flash-latest
KAIKU_LLM_TIMEOUT_MS=8000
# OpenAI-compatible endpoint instead (e.g. self-hosted Gemma):
# KAIKU_LLM_PROVIDER=openai
# KAIKU_LLM_URL=http://localhost:8000/v1/chat/completions
# KAIKU_LLM_KEY=

# --- Data ---
# auto = S-Pankki CSV if present, otherwise demo fixtures. Values: auto | csv | fixture
KAIKU_DATA_SOURCE=auto
KAIKU_DATASET=data/tx_junction_transactions.csv
KAIKU_CUSTOMER_ID=CUST00001

PORT=3000
